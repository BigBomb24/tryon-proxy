{% comment %}
  Virtual Try-On Widget for Symmetry 8.0.0
  Add this as a Custom HTML block on the Product page in theme editor
  OR add it to sections/product-template.liquid

  INSTRUCTIONS:
  1. Go to Shopify Admin → Online Store → Themes → Customize
  2. Open a Product page
  3. Click "Add block" → "Custom Liquid"
  4. Paste this entire code
  5. Save
{% endcomment %}

<div class="tryon-widget-wrap" style="margin: 40px 0;">

  <div class="tryon-toggle-btn" onclick="toggleTryOn()" style="
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #1C1917;
    color: #FAF7F2;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 28px;
    border-radius: 100px;
    cursor: pointer;
    border: none;
    transition: background 0.3s;
    width: 100%;
    justify-content: center;
    box-sizing: border-box;
  ">
    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
    </svg>
    ✦ Virtual Try-On — See How It Looks On You
  </div>

  <div id="tryon-iframe-wrap" style="display:none; margin-top: 16px;">
    <iframe
      id="tryon-iframe"
      src=""
      width="100%"
      height="780px"
      frameborder="0"
      style="border-radius: 16px; border: 1px solid #E2DDD7; display: block;"
      loading="lazy"
      title="Virtual Try-On"
    ></iframe>
  </div>

</div>

<script>
(function() {
  // ── CONFIG — CHANGE THIS TO YOUR VERCEL URL ──────────────────────────────
  var TRYON_BASE_URL = 'https://tryon-proxy-1wn3.vercel.app';
  // ─────────────────────────────────────────────────────────────────────────

  var loaded = false;

  // Get product image from Shopify
  var productImg  = {{ product.featured_image | img_url: '800x' | json }};
  var productName = {{ product.title | json }};

  window.toggleTryOn = function() {
    var wrap = document.getElementById('tryon-iframe-wrap');
    var btn  = document.querySelector('.tryon-toggle-btn');

    if (wrap.style.display === 'none') {
      wrap.style.display = 'block';
      btn.style.background = '#C4884A';

      // Load iframe only once
      if (!loaded) {
        var src = TRYON_BASE_URL
          + '?img=' + encodeURIComponent('https:' + productImg)
          + '&name=' + encodeURIComponent(productName);

        document.getElementById('tryon-iframe').src = src;
        loaded = true;
      }

      // Smooth scroll to widget
      setTimeout(function() {
        wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);

    } else {
      wrap.style.display = 'none';
      btn.style.background = '#1C1917';
    }
  };
})();
</script>
